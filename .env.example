# Подключение к PostgreSQL для Prisma.
# Заполнить на фазе подключения БД (скопировать в .env).
DATABASE_URL="postgresql://user:password@localhost:5432/stockpoisk?schema=public"

# Администраторы: числовые VK ID через запятую. Доступ к админке — по РОЛИ на
# сессии VK ID (не по общему токену). Свой ID: войти → Профиль → «ID …».
ADMIN_VK_IDS=""

# VK ID OAuth («Войти через ВК» на сайте). App ID публичный, секрет — нет.
# Кабинет id.vk.ru → приложение 54693313:
#   • Базовый домен: search-app.ru
#   • Доверенный redirect URL: https://search-app.ru/api/auth/vk/callback
VK_APP_ID="54693313"
VK_REDIRECT_URI="https://search-app.ru/api/auth/vk/callback"
# «Сервисный ключ доступа» из кабинета — для конфиденциального приложения при
# обмене кода. Публичному (PKCE) не нужен — оставить пустым.
VK_SERVICE_TOKEN=""

# Секрет подписи сессий (httpOnly-cookie). Сгенерировать: openssl rand -hex 32
SESSION_SECRET=""

# Тестовый вход по имени. ВЫКЛЮЧЕН по умолчанию (VK ID подключён).
# Аварийный доступ на время проверки VK: ALLOW_TEST_LOGIN=1 (потом убрать).
ALLOW_TEST_LOGIN=""
