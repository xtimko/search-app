// Схема БД «СтокПоиск» (PostgreSQL).
// Мультикатегорийный агрегатор стока для реселлеров: обувь, одежда,
// аксессуары (часы, сумки, головные уборы), украшения, люкс, коллекционное.
// См. docs/ARCHITECTURE.md и docs/research/vk_chat_analysis.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Статус модерации продавца.
enum SellerStatus {
  pending
  approved
  blocked
}

// Состояние товара.
enum Condition {
  new
  used
}

// Категория товара. Дерево (parent/children) — с запасом под расширение
// (обувь, одежда, аксессуары → часы/сумки/украшения, люкс…). Ведёт администратор.
model Category {
  id       Int        @id @default(autoincrement())
  name     String     @unique
  slug     String     @unique
  parentId Int?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  models   Model[]
}

// Бренд — единый справочник. aliases — варианты написания/сленг (nb, нб, форсы…).
model Brand {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  aliases String[] @default([])
  models  Model[]
}

// Статус карточки модели: verified — «жёсткая база» (сид/админ), pending — создана
// продавцом и ждёт модерации (используется, но помечена «на модерации»).
enum ModelStatus {
  verified
  pending
}

// Модель/референс справочника — привязана к бренду и категории.
// aliases — синонимы/сленг/артикулы для поиска. sku — артикул.
model Model {
  id         Int       @id @default(autoincrement())
  brandId    Int
  brand      Brand     @relation(fields: [brandId], references: [id])
  categoryId Int
  category   Category  @relation(fields: [categoryId], references: [id])
  name       String
  aliases    String[]  @default([])
  sku        String? // заводской артикул бренда (напр. adidas B75806)
  status     ModelStatus @default(verified)
  imageUrl   String? // каталожное фото модели (подставляется в выдаче, если у объявления нет своего)
  colorway    String? // флагманская расцветка (соответствует sku)
  retailPrice Int? // ритейл-цена в рублях (вводит админ; официального ритейла в РФ нет)
  releaseYear Int? // год выпуска силуэта (у силуэта нет одной даты релиза расцветки)
  description String? // короткое описание модели для страницы товара
  listings   Listing[]
  requests   Request[]
  searchLogs SearchLog[]

  @@unique([brandId, name])
  @@index([categoryId])
}

// Товар в стоке — конкретный экземпляр у продавца.
model Listing {
  id        Int       @id @default(autoincrement())
  sellerId  Int
  seller    Seller    @relation(fields: [sellerId], references: [id])
  modelId   Int
  model     Model     @relation(fields: [modelId], references: [id])
  sizeUs    String? // обувь (US), напр. "9.5"
  sizeEu    String? // обувь (EU), напр. "43"
  size      String? // одежда/аксессуары: "M", "42mm", "one size"
  colorway  String? // расцветка: Mocha, Onyx
  condition Condition @default(new)
  hasBox    Boolean   @default(true) // наличие коробки/комплекта
  fitting   Boolean   @default(false) // «примерка» да/нет
  price     Int // в рублях
  city      String?
  photo     String? // ссылка на фото
  comment   String?
  inStock   Boolean   @default(true) // «продано» выключает в один тап
  reserved  Boolean   @default(false) // в открытой сделке (скрыто из поиска)
  conversations Conversation[]
  deals     Deal[]
  requestResponses RequestResponse[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([modelId])
  @@index([inStock])
}

// Статус сделки.
enum DealStatus {
  open
  completed
  cancelled
}

// Тип сообщения: текст, оффер (предложение цены), системное.
enum MessageKind {
  text
  offer
  system
}

// Статус оффера.
enum OfferStatus {
  active
  accepted
  declined
  superseded
}

// Сделка: принятый оффер по конкретной позиции. Открыта → позиция в резерве;
// оба подтвердили → completed + «продано»; отмена → резерв снят.
model Deal {
  id              Int          @id @default(autoincrement())
  conversationId  Int
  conversation    Conversation @relation(fields: [conversationId], references: [id])
  listingId       Int
  listing         Listing      @relation(fields: [listingId], references: [id])
  buyerId         Int
  buyer           Seller       @relation("buyerDeals", fields: [buyerId], references: [id])
  sellerId        Int
  seller          Seller       @relation("sellerDeals", fields: [sellerId], references: [id])
  price           Int // зафиксированная цена
  status          DealStatus   @default(open)
  buyerConfirmed  Boolean      @default(false)
  sellerConfirmed Boolean      @default(false)
  guarantor       String? // опциональный гарант-посредник (имя/контакт)
  review          Review?
  createdAt       DateTime     @default(now())
  closedAt        DateTime?

  @@index([buyerId])
  @@index([sellerId])
  @@index([listingId, status])
}

// Лог поискового запроса (для аналитики спроса). Пишется при поиске с текстом.
model SearchLog {
  id        Int      @id @default(autoincrement())
  query     String // нормализованный текст запроса
  modelId   Int? // сматченная модель (топ по релевантности), null — не распознали
  model     Model?   @relation(fields: [modelId], references: [id], onDelete: SetNull)
  city      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([modelId])
}

// Статус запроса «Ищу».
enum RequestStatus {
  active
  closed
}

// Запрос покупателя «Ищу»: модель из справочника + размер/бюджет/город.
model Request {
  id        Int           @id @default(autoincrement())
  buyerId   Int
  buyer     Seller        @relation("requests", fields: [buyerId], references: [id])
  modelId   Int
  model     Model         @relation(fields: [modelId], references: [id])
  size      String? // желаемый размер (US/EU/одежда — строкой)
  maxPrice  Int? // бюджет, ₽
  city      String?
  comment   String?
  status    RequestStatus @default(active)
  responses RequestResponse[]
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
  @@index([buyerId])
}

// Отклик продавца на запрос: конкретная позиция → чат с оффером.
model RequestResponse {
  id             Int      @id @default(autoincrement())
  requestId      Int
  request        Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sellerId       Int
  seller         Seller   @relation("requestResponses", fields: [sellerId], references: [id])
  listingId      Int
  listing        Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  conversationId Int
  createdAt      DateTime @default(now())

  @@unique([requestId, listingId])
}

// Отзыв покупателя о продавце по завершённой сделке (один на сделку).
model Review {
  id        Int      @id @default(autoincrement())
  dealId    Int      @unique
  deal      Deal     @relation(fields: [dealId], references: [id])
  sellerId  Int // кому отзыв
  seller    Seller   @relation("reviewsReceived", fields: [sellerId], references: [id])
  authorId  Int
  author    Seller   @relation("reviewsAuthored", fields: [authorId], references: [id])
  rating    Int // 1..5
  text      String?
  createdAt DateTime @default(now())

  @@index([sellerId])
}

// Диалог покупателя с продавцом по конкретному товару.
model Conversation {
  id        Int       @id @default(autoincrement())
  listingId Int
  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId   Int // кто написал первым
  buyer     Seller    @relation("buyerConversations", fields: [buyerId], references: [id])
  sellerId  Int // владелец товара
  seller    Seller    @relation("sellerConversations", fields: [sellerId], references: [id])
  messages  Message[]
  deals     Deal[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt // время последнего сообщения (для сортировки)

  @@unique([listingId, buyerId])
  @@index([buyerId])
  @@index([sellerId])
}

// Сообщение в диалоге. readAt — когда прочитано получателем.
model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       Int
  sender         Seller       @relation(fields: [senderId], references: [id])
  text           String
  kind           MessageKind  @default(text)
  offerPrice     Int? // для kind=offer
  offerStatus    OfferStatus? // для kind=offer
  createdAt      DateTime     @default(now())
  readAt         DateTime?

  @@index([conversationId, createdAt])
}

// Продавец (реселлер). Один пользователь ВК может быть и продавцом, и покупателем.
model Seller {
  id          Int          @id @default(autoincrement())
  vkId        BigInt       @unique
  nick        String
  vkName      String? // имя+фамилия из VK ID
  photo       String? // аватар из VK ID
  contact     String // ссылка на ВК / Telegram
  city        String?
  experience  String? // стаж
  description String?
  status      SellerStatus @default(pending)
  listings    Listing[]
  buyerConversations  Conversation[] @relation("buyerConversations")
  sellerConversations Conversation[] @relation("sellerConversations")
  buyerDeals  Deal[] @relation("buyerDeals")
  sellerDeals Deal[] @relation("sellerDeals")
  reviewsReceived Review[] @relation("reviewsReceived")
  reviewsAuthored Review[] @relation("reviewsAuthored")
  requests    Request[] @relation("requests")
  requestResponses RequestResponse[] @relation("requestResponses")
  messages    Message[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}
